# Postgres connection string (Neon in production and preview).
DATABASE_URL=
# Better Auth: a long random secret, and the app's public base URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Google OAuth client for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The email that becomes the Owner on first sign-in.
OWNER_EMAIL=
# End-to-end tests read E2E_DATABASE_URL, a throwaway Postgres on localhost wiped
# on every run, from the shell rather than this file (Playwright loads no .env):
#   E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/e2e npm run e2e
